# Instantly Automation Service Configuration

# API key for authenticating requests (generate a secure random string)
API_KEY=your-secure-api-key-here

# Port to run the service on
PORT=3100

# Set to "false" to run browser in headed mode (for debugging)
HEADLESS=true

# Logging level: error, warn, info, debug
LOG_LEVEL=info

# Path to store error screenshots
SCREENSHOTS_PATH=/app/screenshots
